  "components": {
    "schemas": {
      "Contact": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": ["string", "null"] },
          "phone": { "type": ["string", "null"] },
          "company": { "type": ["string", "null"] },
          "role": { "type": ["string", "null"] },
          "linkedin_url": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "has_lead": { "type": "boolean" },
          "lead": {
            "type": ["object", "null"],
            "properties": {
              "id": { "type": "integer" },
              "category_id": { "type": "integer" },
              "status": { "type": "string" },
              "status_label": { "type": "string" },
              "notes": { "type": ["string", "null"] },
              "created_at": { "type": "string", "format": "date-time" },
              "updated_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "required": ["id", "name", "created_at", "updated_at", "has_lead"]
      },
      "ContactInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "company": { "type": "string" },
          "role": { "type": "string" },
          "linkedin_url": { "type": "string" },
          "notes": { "type": "string" }
        },
        "required": ["name"]
      },
      "Lead": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "contact_id": { "type": "integer" },
          "category_id": { "type": "integer" },
          "status": { "type": "string", "enum": ["backlog", "in_progress", "done", "archived"] },
