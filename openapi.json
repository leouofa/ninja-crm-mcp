{
  "openapi": "3.1.0",
  "info": {
    "title": "Ninja CRM API",
    "description": "REST API for Ninja CRM, providing endpoints to manage Contacts, Leads, Categories, and Outreach Templates for TypeScript apps and MCP servers.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API v1 Endpoint Base"
    }
  ],
  "tags": [
    { "name": "Contacts", "description": "Manage contacts and outreach prospects" },
    { "name": "Leads", "description": "Manage pipeline leads across backlog, in_progress, done, and archived statuses" },
    { "name": "Categories", "description": "Manage lead categories and vertical groupings" },
    { "name": "Templates", "description": "Manage outreach email and message templates associated with categories" }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": ["Contacts"],
        "summary": "List contacts",
        "description": "Retrieves contacts with optional keyword search, sorting, and pagination. Embedded lead metadata is included.",
        "parameters": [
          { "name": "q", "in": "query", "description": "Search keyword matching name, email, company, or role", "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "description": "Field to sort by (name, email, company, role, created_at, updated_at)", "schema": { "type": "string", "default": "name" } },
          { "name": "order", "in": "query", "description": "Sort order: asc or desc", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "asc" } },
          { "name": "limit", "in": "query", "description": "Number of results to return (max 100)", "schema": { "type": "integer", "default": 50 } },
          { "name": "offset", "in": "query", "description": "Offset from beginning of results", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": {
            "description": "A list of contacts",
            "headers": {
              "X-Total-Count": { "description": "Total number of matching records", "schema": { "type": "integer" } },
              "X-Limit": { "description": "Current page limit", "schema": { "type": "integer" } },
              "X-Offset": { "description": "Current page offset", "schema": { "type": "integer" } }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Contact" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Contacts"],
        "summary": "Create a new contact",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ContactInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contact created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Contact" }
              }
            }
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationError" }
              }
            }
          }
        }
      }
    },
    "/contacts/{id}": {
      "get": {
        "tags": ["Contacts"],
        "summary": "Get a contact by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Contact details",
            "content": {
              "application/json": {
